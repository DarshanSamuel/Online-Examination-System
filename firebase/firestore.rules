rules_version = '2';

// Security model:
//  * The Express API uses the Admin SDK (bypasses these rules) and owns ALL candidate writes,
//    so deadlines, answer validation and warning counts can't be forged from the browser.
//  * Candidates can read their profile, their assignments, and published exams.
//  * Examiners author exams/questions directly from the dashboard and read results for exams.
//  * Answer keys & hidden tests live in questions/{id}/secrets — never readable by candidates.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()      { return request.auth != null; }
    function viaGoogle()     { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function isExaminer()    { return viaGoogle() && request.auth.token.role == 'examiner'; }
    function myEmail()       { return request.auth.token.email.lower(); }
    function ownsExam(examId) {
      return isExaminer() && get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid;
    }

    // ── users ───────────────────────────────────────────────
    match /users/{uid} {
      allow read: if viaGoogle() && (request.auth.uid == uid || isExaminer());
      allow write: if false; // server only (/api/auth/session)
    }

    // ── exams ───────────────────────────────────────────────
    match /exams/{examId} {
      allow read: if (isExaminer() && resource.data.createdBy == request.auth.uid)
                  || (viaGoogle() && resource.data.status == 'published');
      allow create: if isExaminer()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'draft';
      allow update: if isExaminer()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isExaminer()
                    && resource.data.createdBy == request.auth.uid
                    && resource.data.status == 'draft';
    }

    // ── assignments ─────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if isExaminer()
                  || (viaGoogle() && resource.data.candidateEmail == myEmail());
      allow create, update: if isExaminer()
                            && ownsExam(request.resource.data.examId)
                            && request.resource.data.candidateEmail == request.resource.data.candidateEmail.lower()
                            && request.resource.data.status == 'assigned';
      allow delete: if isExaminer() && ownsExam(resource.data.examId);
    }

    // ── questions (examiner-owned question banks) ───────────
    match /questions/{questionId} {
      allow read, delete: if isExaminer() && resource.data.createdBy == request.auth.uid;
      allow create: if isExaminer() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isExaminer()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.version == resource.data.version + 1;

      match /secrets/{docId} {
        allow read, write: if isExaminer()
                           && get(/databases/$(database)/documents/questions/$(questionId)).data.createdBy == request.auth.uid;
      }
    }

    // ── submissions (server-written, examiner-readable) ─────
    match /submissions/{submissionId} {
      allow read: if isExaminer();
      allow write: if false;

      match /{sub=**} {
        allow read: if isExaminer();
        allow write: if false;
      }
    }

    // ── plagiarism reports ──────────────────────────────────
    match /similarityReports/{reportId} {
      allow read: if isExaminer();
      allow write: if false;
    }
  }
}
