# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ── Firebase Admin ────────────────────────────────────────
# Either set GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# or provide the three values below.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences; they are converted at runtime.
FIREBASE_PRIVATE_KEY=

# Emails that become examiners on first login (comma-separated)
EXAMINER_EMAILS=teacher@example.com

# ── Code execution ────────────────────────────────────────
# judge0 | piston
EXECUTION_PROVIDER=judge0

# Self-hosted Judge0 (recommended for exams):
#   JUDGE0_URL=http://judge0:2358
#   JUDGE0_AUTH_HEADER=X-Auth-Token
#   JUDGE0_AUTH_TOKEN=<AUTHN_TOKEN from judge0.conf>
# RapidAPI-hosted Judge0 CE:
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_AUTH_HEADER=
JUDGE0_AUTH_TOKEN=

# Self-hosted Piston
PISTON_URL=http://localhost:2000

# ── Exam policy ───────────────────────────────────────────
MAX_CODE_BYTES=65536
RUN_RATE_LIMIT_PER_MIN=10
ENABLE_SWEEPER=true
SWEEPER_INTERVAL_SEC=30

# Vercel only: long random string; Vercel Cron sends it as a Bearer token to /api/internal/sweep.
# On Vercel also set ENABLE_SWEEPER=false (the in-process interval can't run on serverless).
CRON_SECRET=
